# ===========================================
# MetyAmiko - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metyamiko
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metyamiko

# --- Backend (FastAPI) ---
BACKEND_PORT=8002
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1
NEXT_PUBLIC_APP_NAME=MetyAmiko

# --- CORS (comma-separated origins allowed to call the backend) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Supabase (File Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=cv-uploads

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL_PARSING=claude-haiku-4-5-20251001
CLAUDE_MODEL_MATCHING=claude-sonnet-4-6

# --- Email (Optional - for password reset) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
EMAIL_FROM=noreply@metyamiko.com

# --- Sentry (Optional - monitoring) ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Redis (Optional - for rate limiting/queues) ---
REDIS_URL=redis://localhost:6379
